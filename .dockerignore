# Exclude local environment files to prevent baking secrets into Docker image layers
.env
.env.*
.env.local

# Exclude the local virtual environment
.venv/
venv/
env/

# Exclude raw PDFs and local DB files while preserving pre-built FAISS index
data/raw_pdfs/
!data/faiss_index/
!data/faiss_index/**
*.db
*.sqlite3

# Exclude Python bytecode caches
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Exclude source control logs and IDE configurations
.git/
.gitignore
.vscode/
.idea/