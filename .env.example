# =====================================================================
# FinSight RegTech Compliance Engine - Environment Configuration
# =====================================================================

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. PostgreSQL Audit Ledger Database Configuration
POSTGRES_DB=finsight_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# (Optional alias for Docker container network resolution)
DB_HOST=localhost

# 3. Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
