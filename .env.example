# =====================================================================
# FinSight RegTech Compliance Engine - Environment Configuration
# =====================================================================

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 2. PostgreSQL Audit Ledger Database Configuration
POSTGRES_DB=finsight_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# (Optional alias for Docker container network resolution)
DB_HOST=localhost

# 3. Security & Authentication Configuration (Mandatory)
# Generate a strong 256-bit secret key (e.g., via `openssl rand -hex 32`)
JWT_SECRET_KEY=your_jwt_secret_signing_key_at_least_32_characters_long

# 4. CORS Allowed Origins (Comma-separated exact origins)
FRONTEND_ORIGINS=http://localhost:3000,https://finsight-phi-ten.vercel.app

# 5. Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
